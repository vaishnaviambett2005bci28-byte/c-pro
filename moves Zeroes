void moveZeroes(int* nums, int numsSize) 
 {
    int insertPos = 0;
    for (int i = 0; i < numsSize; i++) 
    {
        if (nums[i] != 0) 
        {
            nums[insertPos] = nums[i];
            insertPos++;
        }
    }
    while (insertPos < numsSize) 
    {
        nums[insertPos] = 0;
        insertPos++;
    }
}    
Input:
nums =[0,1,0,3,12]
Output:
[1,3,12,0,0]
