#include <stdbool.h>
#include <string.h>

bool isIsomorphic(char* s, char* t) {
   
    int len = strlen(s);
    if (len != strlen(t)) {
        return false;
    }

    
    int mapS[256] = {0};
    int mapT[256] = {0};

    for (int i = 0; i < len; i++) {
      
        unsigned char charS = (unsigned char)s[i];
        unsigned char charT = (unsigned char)t[i];

        if (mapS[charS] != mapT[charT]) {
            return false;
        }

        
        mapS[charS] = i + 1;
        mapT[charT] = i + 1;
    }
