bool isPalindrome(int x) {
    long long int result=0,temp;
    temp=x;  
    if(x<0)
    {
        return false;  
    }

    while(x!=0)
    {
        
        result=result*10+(x%10);  
        x/=10;
        
    }

  if(result!=temp)
  {
    return false; 
  }
 return true;
}
