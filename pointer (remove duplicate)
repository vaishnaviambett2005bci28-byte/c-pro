int removeDuplicates(int* nums, int numsSize) 
{
    if (numsSize == 0) 
    {
        return 0;
    }
    int writePointer = 1; 
    for (int i = 1; i < numsSize; i++) 
    {
        if (nums[i] != nums[i - 1]) 
        {
            nums[writePointer] = nums[i];
            writePointer++;
        }
    }
    return writePointer;
}
Input:
nums =[1,1,2]
Output:
[1,2]
